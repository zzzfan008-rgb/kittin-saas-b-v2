{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://garment-canvas.local/schemas/apiyi-consultation-receipt-v1.json",
  "title": "API易本地知识库咨询凭证",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "createdAt",
    "baseCommit",
    "changeFingerprintSha256",
    "knowledgeSnapshotId",
    "knowledgeSnapshotSha256",
    "query",
    "affectedPaths",
    "sources",
    "decisionSummary",
    "unresolvedChoices"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "changeFingerprintSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "knowledgeSnapshotId": { "type": "string", "minLength": 1 },
    "knowledgeSnapshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "query": { "type": "string", "minLength": 1 },
    "affectedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonicalUrl", "snapshotRelativePath", "pageLocalPath", "title", "sha256"],
        "properties": {
          "canonicalUrl": { "type": "string", "pattern": "^https://docs\\.apiyi\\.com(?:/|$)" },
          "snapshotRelativePath": { "type": "string", "minLength": 1 },
          "pageLocalPath": { "type": "string", "pattern": "^pages/" },
          "title": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "decisionSummary": { "type": "string", "minLength": 1 },
    "unresolvedChoices": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
