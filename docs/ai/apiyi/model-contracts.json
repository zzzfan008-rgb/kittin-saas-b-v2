    "reasoningEffort": "medium",
    "forbiddenParams": ["minimal", "thinkingBudget"],
    "temperature": 0.4,
    "maxTokens": 512,
    "timeoutMs": 20000,
    "maxRetries": 1,
    "retryableErrorCodes": ["text_transport_error", "text_rate_limited", "text_upstream_error"],
    "pricingPerMillionTokens": { "inputUsd": 0.75, "outputUsd": 3.75, "thinkingBilledAsOutput": true },
