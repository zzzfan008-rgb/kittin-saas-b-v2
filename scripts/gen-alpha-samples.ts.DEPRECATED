#!/usr/bin/env -S npx tsx

/**
 * 62-plan-alpha/gen-alpha-samples.ts
 *
 * 方案 α 执行脚本：从 golden-set 抽 12 gen + 12 edit = 24 次请求，
 * 走 POST /api/generate 生产路径（含 normalize），结果存 tmp/alpha-24-samples/。
 *
 * 用法：
 *   npx tsx scripts/gen-alpha-samples.ts
 *   # 或通过 npm alias：
 *   npm run evaluation:alpha:gen
 *
 * 环境变量（必填）：
 *   ALPHA_AUTH_TOKEN   — admin session cookie 值（Cookie name: gc_session）
 *   ALPHA_BASE_URL     — dev server URL，默认 http://localhost:3001
 *   MODEL_ID           — 模型 ID，默认 gpt-image-2.5-flare-vip
 *
 * 样本分配：
 *   samples[0..11]  → 12 张 generate
 *   samples[12..23] → 12 张 edit
 */

import * as fs from "node:fs";
import * as path from "node:path";
import * as https from "node:https";
import * as http from "node:http";

// ── config ──────────────────────────────────────────────────────────────────

const BASE_URL = process.env.ALPHA_BASE_URL ?? "http://localhost:3001";
const AUTH_TOKEN = process.env.ALPHA_AUTH_TOKEN;
const MODEL_ID = process.env.MODEL_ID ?? "gpt-image-2.5-flare-vip";

const OUT_DIR = path.resolve("/Users/lionfan/.hermes/profiles/architect/cache/scratch/tmp/alpha-24-samples");
const GEN_DIR = path.join(OUT_DIR, "generate");
const EDIT_DIR = path.join(OUT_DIR, "edit");

// ── sanity checks ───────────────────────────────────────────────────────────

if (!AUTH_TOKEN) {
  console.error("❌ ALPHA_AUTH_TOKEN env var required.");
  console.error("   查找方法：在浏览器 DevTools → Application → Cookies → localhost → 找 gc_session，复制其值。");
  process.exit(1);
}

fs.mkdirSync(GEN_DIR, { recursive: true });
fs.mkdirSync(EDIT_DIR, { recursive: true });

