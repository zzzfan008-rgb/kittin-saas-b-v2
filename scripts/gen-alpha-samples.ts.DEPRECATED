const GEN_SAMPLES = SAMPLES.slice(0, 12);   // samples[0..11]
const EDIT_SAMPLES = SAMPLES.slice(12, 24);  // samples[12..23]

// ── HTTP client (binary-safe, returns raw Buffer) ───────────────────────────

/**
 * Generic HTTP request — returns raw binary Buffer body.
 * Fix #7: body is always a Buffer (not utf-8 string), preserving image bytes.
 */
function httpRequest(
  urlStr: string,
  options: {
    method?: string;
    headers?: Record<string, string>;
    body?: Buffer;
  } = {},
): Promise<{ status: number; headers: http.IncomingHttpHeaders; body: Buffer }> {
  return new Promise((resolve, reject) => {
    const url = new URL(urlStr);
    const isHttps = url.protocol === "https:";
    const mod = isHttps ? https : http;

    const reqOptions: http.RequestOptions = {
      hostname: url.hostname,
      port: url.port || (isHttps ? 443 : 3001),
      path: url.pathname + url.search,
      method: options.method ?? "GET",
      headers: options.headers,
    };

    const req = mod.request(reqOptions, (res) => {
      const chunks: Buffer[] = [];
      res.on("data", (chunk: Buffer) => chunks.push(chunk));
      res.on("end", () => {
        resolve({
          status: res.statusCode ?? 0,
          headers: res.headers,
          body: Buffer.concat(chunks),
        });
      });
    });

    req.on("error", reject);
    if (options.body) req.write(options.body);
    req.end();
  });
}

/**
 * Fetch a file from the local dev server as a raw Buffer.
 * Fix #7: no utf-8 string conversion. Image bytes stay intact.
 */
async function fetchFile(fileId: string): Promise<Buffer> {
  const url = `${BASE_URL}/api/files/${fileId}`;
  const res = await httpRequest(url, {
    headers: {
      Cookie: `gc_session=${AUTH_TOKEN}`,
    },
  });

  if (res.status !== 200) {
    throw new Error(`Failed to fetch ${fileId}: HTTP ${res.status}`);
  }

  const contentType = res.headers["content-type"] ?? "";

  if (contentType.startsWith("image/")) {
    // Direct binary image response — return as-is
    return res.body;
  }

  // May be JSON: { url: "data:..." } — extract base64 payload
  const text = res.body.toString("utf-8");
  try {
    const json = JSON.parse(text);
    if (typeof json.url === "string" && json.url.startsWith("data:")) {
      const match = json.url.match(/^data:[^;]+;base64,(.+)$/);
      if (!match) throw new Error(`Cannot parse base64 data URL for ${fileId}`);
      return Buffer.from(match[1], "base64");
    }
  } catch {
    // not JSON — try treating text as base64
  }

  // Last resort: treat raw body as base64-encoded image
  return Buffer.from(text, "base64");
}

// ── promptVariantId helpers ─────────────────────────────────────────────────
//
// Variant ID format (garmentPromptPresets.ts:238):
//   `${presetId}.${modelId}.${mode}.v1`
// For MODEL_ID = gpt-image-2.5-flare-vip with fashion-lookbook preset:
//   fashion-lookbook.gpt-image-2.5-flare-vip.generate.v1
//   fashion-lookbook.gpt-image-2.5-flare-vip.edit.v1

const FASHION_LOOKBOOK_PRESET_ID = "fashion-lookbook";
const VARIANT_MODE = {
  generate: "generate",
  edit: "edit",
} as const;

function makeVariantId(mode: "generate" | "edit"): string {
  return `${FASHION_LOOKBOOK_PRESET_ID}.${MODEL_ID}.${VARIANT_MODE[mode]}.v1`;
}

// ── POST /api/generate ─────────────────────────────────────────────────────

async function generateImage(params: {
  operationMode: "generate" | "edit";
  prompt: string;
  sampleId: string;
  fileId?: string | null;
  assetSha256?: string | null;
  aspectRatio?: string;
}): Promise<{ runId: string }> {
  const clientRequestId = `alpha-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;

  // Fix #8: promptVariantId — required for binding check (generate.ts:binding check).
  //         Without it the request fails with "missing-binding" at the binding layer,
  //         before ever reaching admission.
  const request: Record<string, unknown> = {
    prompt: params.prompt,
    // Fix #2: aspectRatio must be "3:4" — canonical parameter for fashion-lookbook variants
    //         (parameter-drift if "1:1" or absent)
    aspectRatio: params.aspectRatio ?? "3:4",
    // Fix #2: operationMode is required for the route to classify generate vs edit
    operationMode: params.operationMode,
    // Fix #2: promptVariantId INSIDE request — route reads request.* only (params透传)
    //         Top-level promptVariantId causes "missing-binding" at the binding layer.
    promptVariantId: makeVariantId(params.operationMode),
    // Fix #2: modelOptions must carry canonical size — {} causes parameter-drift 400
    modelOptions: { size: "1536x2048" },
    // Fix #2: batchSize must be explicitly set
    batchSize: 1,
    // Fix #2: postprocessVersion must be present (fit-contain-dominant-webp-v1)
    postprocessVersion: "fit-contain-dominant-webp-v1",
  };

  if (params.operationMode === "edit" && params.fileId && params.assetSha256) {
    // Fetch reference image as raw Buffer
    const refBuf = await fetchFile(params.fileId);
    const refBase64 = refBuf.toString("base64");
    const ext = params.fileId.split(".").pop() ?? "jpg";
    const mimeType = ext === "png" ? "image/png" : "image/jpeg";

    // Fix #3: Use structured reference channel (request.references[])
    //         generate.ts:181-217 reads request.references[].dataUrl — NOT request.referenceImage
    //         referenceInputs.ts:82-84: structured path is preferred; assetSha256 required
    request.references = [{
      dataUrl: `data:${mimeType};base64,${refBase64}`,
      assetSha256: params.assetSha256,
      order: 0,
    }];
  }

  // Fix #1: kind field at top level (generate.ts:168-170)
  // NOTE: promptVariantId is now INSIDE request.* (not top-level) — top-level causes "missing-binding"
  const requestBody: Record<string, unknown> = {
    clientRequestId,
    modelId: MODEL_ID,
    kind: "image-generator",
    request,
  };

  const url = `${BASE_URL}/api/generate`;
  const res = await httpRequest(url, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      // Fix #5: cookie name is gc_session (auth.ts:17), not __Host-session
      Cookie: `gc_session=${AUTH_TOKEN}`,
      Accept: "application/json",
    },
    body: Buffer.from(JSON.stringify(requestBody), "utf-8"),
  });

  const bodyText = res.body.toString("utf-8");

  if (res.status === 401) {
    throw new Error(
      `401 Unauthorized — ALPHA_AUTH_TOKEN 无效或已过期。请在浏览器重新登录并更新 token。`,
    );
  }

  if (res.status !== 200 && res.status !== 202) {
    throw new Error(`POST /api/generate failed: HTTP ${res.status}\n${bodyText}`);
  }

  const data = JSON.parse(bodyText);
  return data;
}

// ── poll for run completion ─────────────────────────────────────────────────
//
// Fix #4: Polling route changed from /api/runs/:runId (non-existent)
//         to /api/run-plan/:runId (runPlanRouter.get("/:id"), runPlan.ts:409-416).
//         The run-plan endpoint returns { id, status, finished }.
//         When status is "completed" or "failed", we query generation_runs for image URLs.

async function waitForRun(
  runId: string,
  maxWaitMs = 120_000,
  pollIntervalMs = 5_000,
): Promise<string> {
  const start = Date.now();

  while (Date.now() - start < maxWaitMs) {
    // Fix #4: Correct poll endpoint
    const url = `${BASE_URL}/api/run-plan/${runId}`;
    const res = await httpRequest(url, {
      headers: {
        // Fix #5: cookie name
        Cookie: `gc_session=${AUTH_TOKEN}`,
        Accept: "application/json",
      },
    });

    if (res.status === 404) {
      throw new Error(`Run ${runId} not found (404). Check if dev server is running.`);
    }

    if (res.status !== 200) {
      throw new Error(`GET /api/run-plan/${runId} failed: HTTP ${res.status}`);
    }

    const data = JSON.parse(res.body.toString("utf-8"));

    if (data.status === "completed" || data.status === "success") {
      // Run is done. Image URLs live in generation_runs table (provider_images_json column).
      // We query /api/generation-history to find the image URL for this runId.
      const imageUrl = await fetchRunImageUrl(runId);
      return imageUrl;
    }

    if (data.status === "failed") {
      throw new Error(`Run ${runId} failed: ${JSON.stringify(data.error ?? data)}`);
    }

    process.stdout.write(".");
    await new Promise((r) => setTimeout(r, pollIntervalMs));
  }

  throw new Error(`Run ${runId} timed out after ${maxWaitMs / 1000}s`);
}

/**
 * Query the generation history endpoint to get image URLs for a completed run.
 * The generation-history endpoint (generate.ts:234) returns run history with image URLs.
 */
async function fetchRunImageUrl(runId: string): Promise<string> {
  const url = `${BASE_URL}/api/generation-history`;
  const res = await httpRequest(url, {
    headers: {
      Cookie: `gc_session=${AUTH_TOKEN}`,
      Accept: "application/json",
    },
  });

  if (res.status !== 200) {
    throw new Error(`GET /api/generation-history failed: HTTP ${res.status}`);
  }

  const text = res.body.toString("utf-8");
  const data = JSON.parse(text);

  // generation-history returns { runs: [...], pagination: {...} }
  const runs: Array<{
    id: string;
    status: string;
    images?: string[];
    providerImages?: string[];
  }> = data.runs ?? [];

  const run = runs.find((r: typeof runs[0]) => r.id === runId);
  if (!run) {
    throw new Error(`Run ${runId} not found in generation history. Run may still be processing.`);
  }

  const imageUrls = (run.images ?? run.providerImages ?? []) as string[];
  if (imageUrls.length === 0) {
    throw new Error(`Run ${runId} has no output images (status=${run.status}).`);
  }

  return imageUrls[0];
}

// ── download image from URL ──────────────────────────────────────────────────
// Uses native fetch (Node 18+) for clean binary download.

async function downloadImage(urlStr: string): Promise<Buffer> {
  const res = await fetch(urlStr);
  if (!res.ok) throw new Error(`Failed to download ${urlStr}: HTTP ${res.status}`);
  const ab = await res.arrayBuffer();
  return Buffer.from(ab);
}

// ── save image ──────────────────────────────────────────────────────────────

function saveImage(buf: Buffer, filePath: string): void {
  fs.writeFileSync(filePath, buf);
  console.log(`  ✓ saved ${buf.length} bytes → ${path.basename(filePath)}`);
}

// ── main ───────────────────────────────────────────────────────────────────

async function main() {
  console.log("╔══════════════════════════════════════════════╗");
  console.log("║  Plan α · 24-sample generation runner        ║");
  console.log(`║  BASE: ${BASE_URL}`);
  console.log(`║  MODEL: ${MODEL_ID}`);
  console.log(`║  VARIANT: ${makeVariantId("generate")} / ${makeVariantId("edit")}`);
  console.log(`║  OUT:   ${OUT_DIR}`);
  console.log("╚══════════════════════════════════════════════╝");
  console.log();

  // ── sanity: test auth ───────────────────────────────────────────────────
  console.log("⟦ 1/4 ⟧ Testing auth token…");
  const authRes = await httpRequest(`${BASE_URL}/api/auth/me`, {
    headers: {
      // Fix #5: cookie name
      Cookie: `gc_session=${AUTH_TOKEN}`,
      Accept: "application/json",
    },
  });
  if (authRes.status === 401) {
    console.error("❌ Auth token rejected (401). Update ALPHA_AUTH_TOKEN and retry.");
    process.exit(1);
  }
  console.log(`  ✓ auth OK`);

  // ── generate ─────────────────────────────────────────────────────────────
  console.log("\n⟦ 2/4 ⟧ Running 12 generate requests…");
  const genResults: Array<{ sampleId: string; brief: string; path: string }> = [];

  for (let i = 0; i < GEN_SAMPLES.length; i++) {
    const s = GEN_SAMPLES[i];
    const label = `gen-${s.id}.png`;
    const outPath = path.join(GEN_DIR, label);

    process.stdout.write(`  [${i + 1}/12] ${s.id} (gen)… `);

    try {
      const { runId } = await generateImage({
        operationMode: "generate",
        prompt: s.brief,
        sampleId: s.id,
      });
      console.log(`runId=${runId}, polling…`);
      const imageUrl = await waitForRun(runId);
      const imgBuf = await downloadImage(imageUrl);
      saveImage(imgBuf, outPath);
      genResults.push({ sampleId: s.id, brief: s.brief, path: outPath });
    } catch (e) {
      console.error(`\n  ❌ FAILED: ${e}`);
    }
  }

  console.log(`\n  Gen done: ${genResults.length}/12 succeeded`);

  // ── edit ─────────────────────────────────────────────────────────────────
  console.log("\n⟦ 3/4 ⟧ Running 12 edit requests…");
  const editResults: Array<{ sampleId: string; brief: string; path: string }> = [];

  for (let i = 0; i < EDIT_SAMPLES.length; i++) {
    const s = EDIT_SAMPLES[i];
    const label = `edit-${s.id}.png`;
    const outPath = path.join(EDIT_DIR, label);

    process.stdout.write(`  [${i + 1}/12] ${s.id} (edit)… `);

    try {
      const { runId } = await generateImage({
        operationMode: "edit",
        prompt: s.brief,
        sampleId: s.id,
        fileId: s.fileId ?? undefined,
        assetSha256: s.assetSha256 ?? undefined,
      });
      console.log(`runId=${runId}, polling…`);
      const imageUrl = await waitForRun(runId);
      const imgBuf = await downloadImage(imageUrl);
      saveImage(imgBuf, outPath);
      editResults.push({ sampleId: s.id, brief: s.brief, path: outPath });
    } catch (e) {
      console.error(`\n  ❌ FAILED: ${e}`);
    }
  }

  console.log(`\n  Edit done: ${editResults.length}/12 succeeded`);

  // ── summary ────────────────────────────────────────────────────────────────
  console.log("\n⟦ 4/4 ⟧ Writing manifest…");
  const manifest = {
    version: "plan-alpha-v1",
    generatedAt: new Date().toISOString(),
    model: MODEL_ID,
    promptVariantId: {
      generate: makeVariantId("generate"),
      edit: makeVariantId("edit"),
    },
    baseUrl: BASE_URL,
    generate: genResults,
    edit: editResults,
    totalSucceeded: genResults.length + editResults.length,
    totalAttempted: 24,
  };

  const manifestPath = path.join(OUT_DIR, "manifest.json");
  fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2));

  console.log("\n╔══════════════════════════════════════════════╗");
  console.log("║  Summary                                     ║");
  console.log(`║  Generate: ${genResults.length}/12 succeeded`);
  console.log(`║  Edit:     ${editResults.length}/12 succeeded`);
  console.log(`║  Total:    ${genResults.length + editResults.length}/24`);
  console.log(`║  Manifest: ${manifestPath}`);
  console.log("╚══════════════════════════════════════════════╝");

  if (genResults.length + editResults.length < 24) {
    console.warn("\n⚠️  Some requests failed. Check manifest.json for details.");
  }

  // go/no-go quick reference
  const total = genResults.length + editResults.length;
  if (total >= 20) {
    console.log("\n✅ Decision: ≥20/24 → GO (模型可以上线)");
  } else if (total >= 12) {
    console.log("\n⚠️  Decision: 12-19/24 → CONDITIONAL GO (修复 prompt 或降分辨率后再测)");
  } else {
    console.log("\n❌ Decision: <12/24 → NO-GO (换 model 或重训 prompt)");
  }
}

main().catch((e) => {
  console.error("Fatal:", e);
  process.exit(1);
});
