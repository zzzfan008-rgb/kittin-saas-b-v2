{
  "name": "garment-canvas",
  "private": true,
  "version": "0.1.1",
  "description": "Garment design collaboration SaaS - infinite canvas + node workflow (P0 MVP)",
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "qs": "6.16.0"
  },
  "scripts": {
    "predev": "npm run dev:check",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:check": "tsx scripts/dev-preflight.ts",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc -b && vite build && node scripts/verify-built-css.mjs && node scripts/verify-bundle-budget.mjs",
    "build:server": "tsx scripts/build-server.ts",
    "start": "NODE_ENV=production node dist-server/index.js",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm run build:web && npm run test",
    "test": "node scripts/test-with-postgres.mjs",
    "test:e2e": "node scripts/e2e-with-postgres.mjs",
    "test:e2e:production": "node scripts/e2e-production-smoke.mjs",
    "test:e2e:run": "playwright test",
    "gate:codex": "node scripts/codex-gate.mjs",
    "gate:receipt:verify": "node scripts/gate-receipt-verify.mjs",
    "docs:apiyi:check": "node scripts/apiyi-docs.mjs check",
    "docs:apiyi:refresh": "node scripts/apiyi-docs.mjs refresh",
    "docs:apiyi:kb:sync": "node scripts/apiyi-kb.mjs sync",
    "docs:apiyi:kb:check": "node scripts/apiyi-kb.mjs check",
    "docs:apiyi:search": "node scripts/apiyi-kb.mjs search",
    "docs:apiyi:lookup": "node scripts/apiyi-kb.mjs lookup",
    "docs:apiyi:guard": "node scripts/apiyi-kb.mjs guard",
    "evaluation:authorize": "tsx scripts/evaluation-authorize.ts",
    "evaluation:manifest:check": "tsx scripts/evaluation-manifest.ts",
    "evaluation:review": "tsx scripts/evaluation-review.ts",
    "evaluation:release:preflight": "tsx scripts/evaluation-release-preflight.ts",
    "evaluation:node-matrix:check": "tsx scripts/node-prompt-parameter-matrix.ts",
    "audit:performance-baseline": "tsx scripts/performance-baseline.ts",
    "audit:upload-normalization": "tsx scripts/upload-normalization-benchmark.ts",
    "test:suite": "node scripts/test-suite-parallel.mjs",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app postgres"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@xyflow/react": "^12.3.6",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.33.0",
    "nanoid": "^5.1.0",
    "openai": "^7.15.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "undici": "8.10.1",
    "zundo": "^2.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.39.5",
    "@playwright/test": "1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "dependency-cruiser": "18.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
