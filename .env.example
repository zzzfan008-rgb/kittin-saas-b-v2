# API易图片接口（模型、路径和参数由 docs/ai/apiyi/model-contracts.json 管理）
APIYI_BASE_URL=https://api.apiyi.com
APIYI_API_KEY=sk-your-apiyi-key
# 视频（Seedance）专用令牌；缺省回退 APIYI_API_KEY。Seedance 需令牌勾选 SeeDance2 分组。
# APIYI_VIDEO_API_KEY=sk-your-apiyi-video-key

# 服务端口
PORT=3001
# Vite 开发服务的 /api 代理默认跟随 PORT；只有转发到其他地址时才需要显式配置
# API_PROXY_TARGET=http://localhost:3001

# 数据目录（项目/上传文件）
DATA_DIR=./data

# PostgreSQL 18（本机原生实例或 Docker；密码必须放在私有 .env，不要提交）
POSTGRES_DB=garment_canvas
POSTGRES_USER=garment_canvas
POSTGRES_PASSWORD=replace-with-a-long-random-password
# 开发服务连接的端口：本机原生实例为 5432；Docker 部署用宿主映射端口（示例 54329）
POSTGRES_HOST_PORT=54329
# 连接池上限（可选）
DATABASE_POOL_SIZE=10

# 首次启动管理员（仅数据库还没有用户时使用；密码首次登录后必须修改）
INITIAL_ADMIN_ACCOUNT_ID=replace-with-admin-account
INITIAL_ADMIN_PASSWORD=replace-with-temporary-password

# 升级时要导入的旧 SQLite 文件（相对于 DATA_DIR）
# PostgreSQL 为空时只读导入一次，原文件保留不变
SQLITE_IMPORT_FILE=garment-canvas.db

# 内网 HTTP 部署保持 false；启用 HTTPS 反向代理后改为 true
COOKIE_SECURE=false

# 仅启动 API、不托管 dist 前端（完整部署保持 false）
API_ONLY=false

# AI 调用超时（毫秒；未设置时使用各模型知识库默认值）
# AI_TIMEOUT_MS=300000

# 上传 JPEG 标准化默认使用更快的 libjpeg；仅在回滚时临时启用旧 mozjpeg 路径
# UPLOAD_NORMALIZATION_MOZJPEG=false

# 真实付费评估默认关闭；仅在单独完成预算和一次性授权后开启
ENABLE_PAID_EVALUATION_RUNS=false
# Docker 付费评估构建时必填：把已审核提交写入不可由运行时覆盖的镜像身份文件
# GARMENT_CANVAS_BUILD_CODE_SHA=0123456789abcdef0123456789abcdef01234567
# 开启付费评估时运行时必填，且必须与 Git HEAD 或上面的镜像身份完全一致
# GARMENT_CANVAS_CODE_SHA=0123456789abcdef0123456789abcdef01234567
# 构建身份只证明镜像声明了该 SHA；构建前仍必须由发布门禁证明工作树干净且 HEAD 精确匹配

# 受审评估发布物（默认不配置，所有组合保持 unverified）
# 非空 registry 必须来自 Git 工作树外的只读发布包。构建时通过 BuildKit secret 读取，
# 其中最小运行准入投影会编入前后端产物；审批人、理由、时间及完整证据链只保留在外置包。
# GARMENT_CANVAS_EVALUATION_RELEASE_REGISTRY_SOURCE=/absolute/external/evaluation-release/prompt-release-registry.json
# 包含 registry、contract-check、receipts、promotions 和 retained model catalog 的整个外置发布包目录；
# 必须由 evaluation:review 初始化专用标记，目录/JSON 权限精确为 0755/0644，且不能存在正在更新 registry 的锁文件；发布 Compose 只读挂载，运行时用 Linux mountinfo 再验证整棵树无嵌套 rw
# GARMENT_CANVAS_EVALUATION_RELEASE_HOST_DIR=/absolute/external/evaluation-release
# 非 Docker 部署还需把以下两个运行时路径指向同一外置包；Compose override 会固定设置，无需手写
# GARMENT_CANVAS_EVALUATION_RELEASE_DIR=/absolute/external/evaluation-release
# GARMENT_CANVAS_EVALUATION_RELEASE_REGISTRY_PATH=/absolute/external/evaluation-release/prompt-release-registry.json
# 原始 registry 文件字节 SHA-256；设置后 SOURCE 必须同时存在且完全匹配
# GARMENT_CANVAS_EVALUATION_RELEASE_REGISTRY_SHA256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# registry 递归可达发布闭包的受审根哈希；不得仅为 registry 文件哈希，未引用 exports/孤儿文件不计入
# GARMENT_CANVAS_EVALUATION_RELEASE_BUNDLE_SHA256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# 非空 registry 时 GARMENT_CANVAS_BUILD_CODE_SHA 与 GARMENT_CANVAS_CODE_SHA 都必填，
# 即使 ENABLE_PAID_EVALUATION_RUNS=false 也不例外，因为普通用户会消费已验证发布。

# 完整 JSON 已收齐但连接不结束时的尾部安全收尾（默认开启）
# 关闭时仍保留流式响应大小上限，只禁用宽限期提前收尾
# APIYI_TAIL_STALL_SALVAGE=true
# 最后一块数据后的宽限期，默认 5000ms，允许 1000-30000ms
# APIYI_TAIL_STALL_GRACE_MS=5000

# Generation worker poll interval (ms), default 2000; range 100-60000
GENERATION_WORKER_POLL_MS=2000

# 429 与确认可重试的 503 由 PostgreSQL Worker 最多重试 3 次。
# 超时、连接中断和响应截断不会自动重试。
